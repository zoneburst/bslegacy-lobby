extends Node
##
## Persisted user settings and the paths every other system reads.
##
## Settings live in user://settings.cfg. On desktop that is
## ~/.local/share/godot/app_userdata/<project>/ (Linux),
## %APPDATA%\Godot\app_userdata\<project>\ (Windows), or
## ~/Library/Application Support/Godot/app_userdata/<project>/ (macOS).
## Nothing here is ever bundled into the export, which is why asset overrides
## can point at user:// and survive an update.
##

const SETTINGS_PATH := "user://settings.cfg"

# --- Audio ---
var music_volume: float = 0.6
var sfx_volume: float = 0.8
var mute: bool = false

# --- Display ---
var fullscreen: bool = false
var ui_scale: float = 1.0
var card_animation_speed: float = 1.0
## Battle animations (0.7.0): draw, summon, attack arrow, block, BP clash,
## destruction, life damage, turn and step banners. Off = instant board.
var battle_animations: bool = true
var show_card_tooltips: bool = true
## Reduce motion (0.16.0): turns off the menu extras -- breathing buttons,
## embers, parallax, card fans -- and makes every other menu animation
## instant. Read by Motion.enabled(). The battle animations have their own
## switch above.
var reduce_motion: bool = false
## The "Gate Open, Kaiho!" opening (0.18.4): "off", or a GateOpen variant
## ("isekai", "core", "burst"). Off until a proposal is chosen (I-034).
var gate_open: String = "isekai"     # "Gate Open" (A) on by default since 0.19.0; "off"; "burst" still accepted

# --- Gameplay ---
var auto_pass_empty_flash: bool = true   # skip flash windows with no legal play
var confirm_attacks: bool = true
# 0.13.0: every card that ships with the game was generated by us (the colour
# decks, our starter-deck versions, the samples). 0.23.0: they are OFF unless
# the player turns "Show AI-generated cards" on -- except while there are no
# imported (or bundled) cards at all, when they are the only cards there are
# and stay in view so the game can still be played.
var show_generated_cards: bool = false
## Set by CardDB after loading: true when any imported or bundled card exists.
var real_cards_present: bool = false
## Read everywhere the AI-generated cards may be hidden (the old setting's
## name, kept so every caller still works).
var hide_generated_cards: bool:
	get:
		return not show_generated_cards and real_cards_present
	set(v):
		show_generated_cards = not v
var default_deck_id: String = ""

# --- Identity / network ---
var player_name: String = "Player"
## The online lobby (0.17.0): Create room, Join by code and Quick Match use
## it. The default comes from data/online_lobby.json, which ships with the
## game; Settings can override it. Empty = no online lobby.
var lobby_host: String = ""
var lobby_port: int = 8910
var host_port: int = 8910              # the port "Create room" hosts on when there is no online lobby
var auto_router := true                # ask the router to open host_port (UPnP) when hosting

# --- Asset override roots (see docs/ASSET_REPLACEMENT_GUIDE.md) ---
var card_art_override_dir: String = "user://assets/cards"
var theme_override_path: String = ""
var music_override_dir: String = "user://assets/music"

signal settings_changed


func _ready() -> void:
	load_settings()
	_ensure_user_dirs()


func _ensure_user_dirs() -> void:
	for d in [card_art_override_dir, music_override_dir, "user://decks", "user://reports"]:
		DirAccess.make_dir_recursive_absolute(d)


## The lobby address shipped with the game (data/online_lobby.json).
func _load_lobby_default() -> void:
	var path := "res://data/online_lobby.json"
	if not FileAccess.file_exists(path):
		return
	var d: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if d is Dictionary:
		lobby_host = str((d as Dictionary).get("address", "")).strip_edges()
		lobby_port = int((d as Dictionary).get("port", 8910))
		feedback_url = str((d as Dictionary).get("feedback_url", "")).strip_edges()


## The web build's lobby (0.23.0), first found of:
##   1. the page address: index.html?lobby=ws://127.0.0.1:8941 (testing);
##   2. lobby.json next to index.html -- a small text file in the uploaded
##      zip, so the lobby can be set or changed without rebuilding the game:
##      {"address": "wss://bslegacy-lobby.onrender.com",
##       "feedback_url": "https://you.itch.io/bslegacy"};
##   3. data/online_lobby.json inside the game.
## (Settings has no Connection page in a browser.)
func _web_lobby() -> void:
	_load_lobby_default()
	if not OS.has_feature("web"):
		return
	var txt: Variant = JavaScriptBridge.eval("""(function(){try{var x=new XMLHttpRequest();
		x.open('GET','lobby.json',false);x.send(null);
		return (x.status==200)?x.responseText:'';}catch(e){return '';}})()""", true)
	if txt is String and str(txt).strip_edges().begins_with("{"):
		var d: Variant = JSON.parse_string(str(txt))
		if d is Dictionary:
			var addr := str((d as Dictionary).get("address", "")).strip_edges()
			if _is_ws(addr):
				lobby_host = addr
				lobby_port = 0
			var fb := str((d as Dictionary).get("feedback_url", "")).strip_edges()
			if fb != "":
				feedback_url = fb
	var q: Variant = JavaScriptBridge.eval("new URLSearchParams(window.location.search).get('lobby') || ''", true)
	if q is String and _is_ws(str(q)):
		lobby_host = str(q)
		lobby_port = 0


static func _is_ws(t: String) -> bool:
	var l := t.strip_edges().to_lower()
	return l.begins_with("ws://") or l.begins_with("wss://")


## Shown wherever the lobby is named: "host:port", or the URL itself.
func lobby_label() -> String:
	if _is_ws(lobby_host):
		return lobby_host.replace("wss://", "").replace("ws://", "").trim_suffix("/")
	return "%s:%d" % [lobby_host, lobby_port]


## The game's page, where players can also leave feedback (itch.io), from
## data/online_lobby.json "feedback_url" (0.23.0). Empty = none.
var feedback_url := ""


## True when an online lobby is set up (shipped or in Settings).
## True in the web build (0.21.0): desktop-only features (quitting, the user
## folder, file pickers, spreadsheet import, the ENet lobby) are hidden there.
func is_web() -> bool:
	return OS.has_feature("web")


func has_online_lobby() -> bool:
	if is_web():
		return _is_ws(lobby_host)       # a browser reaches only a WebSocket lobby
	return lobby_host.strip_edges() != ""


func load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) != OK:
		_load_lobby_default()
		if is_web():
			_web_lobby()
		save_settings()
		return
	music_volume = cfg.get_value("audio", "music", music_volume)
	sfx_volume = cfg.get_value("audio", "sfx", sfx_volume)
	mute = cfg.get_value("audio", "mute", mute)
	fullscreen = cfg.get_value("display", "fullscreen", fullscreen)
	ui_scale = cfg.get_value("display", "ui_scale", ui_scale)
	card_animation_speed = cfg.get_value("display", "anim_speed", card_animation_speed)
	battle_animations = cfg.get_value("display", "battle_anims", battle_animations)
	show_card_tooltips = cfg.get_value("display", "tooltips", show_card_tooltips)
	reduce_motion = cfg.get_value("display", "reduce_motion", reduce_motion)
	gate_open = str(cfg.get_value("display", "gate_open", gate_open))
	auto_pass_empty_flash = cfg.get_value("game", "auto_pass", auto_pass_empty_flash)
	confirm_attacks = cfg.get_value("game", "confirm_attacks", confirm_attacks)
	# 0.23.0: a new key, so everyone starts with the AI cards off (the old
	# "hide_generated" setting is not carried over)
	show_generated_cards = cfg.get_value("cards", "show_generated", show_generated_cards)
	default_deck_id = cfg.get_value("game", "default_deck", default_deck_id)
	player_name = cfg.get_value("net", "name", player_name)
	_load_lobby_default()
	# an empty saved address means "the one the game ships with" (0.23.0), so
	# a lobby added to data/online_lobby.json later reaches everyone
	if str(cfg.get_value("net", "host", "")).strip_edges() != "":
		lobby_host = cfg.get_value("net", "host", lobby_host)
		lobby_port = cfg.get_value("net", "port", lobby_port)
	# Before 0.17.0 the lobby defaulted to 127.0.0.1, which only ever meant
	# "this computer" and was saved into every settings file. Read as "none".
	if lobby_host == "127.0.0.1" and int(cfg.get_value("net", "settings_version", 0)) < 17:
		_load_lobby_default()
	host_port = cfg.get_value("net", "host_port", host_port)
	auto_router = cfg.get_value("net", "auto_router", auto_router)
	card_art_override_dir = cfg.get_value("assets", "cards", card_art_override_dir)
	theme_override_path = cfg.get_value("assets", "theme", theme_override_path)
	music_override_dir = cfg.get_value("assets", "music", music_override_dir)
	if is_web():
		_web_lobby()
	_apply_display()


## False in test drivers (0.16.9), so a test that joins an address never
## changes the settings a player has saved.
var persist := true


func save_settings() -> void:
	if not persist:
		return
	var cfg := ConfigFile.new()
	cfg.set_value("audio", "music", music_volume)
	cfg.set_value("audio", "sfx", sfx_volume)
	cfg.set_value("audio", "mute", mute)
	cfg.set_value("display", "fullscreen", fullscreen)
	cfg.set_value("display", "ui_scale", ui_scale)
	cfg.set_value("display", "anim_speed", card_animation_speed)
	cfg.set_value("display", "battle_anims", battle_animations)
	cfg.set_value("display", "tooltips", show_card_tooltips)
	cfg.set_value("display", "reduce_motion", reduce_motion)
	cfg.set_value("display", "gate_open", gate_open)
	cfg.set_value("game", "auto_pass", auto_pass_empty_flash)
	cfg.set_value("game", "confirm_attacks", confirm_attacks)
	cfg.set_value("cards", "show_generated", show_generated_cards)
	cfg.set_value("game", "default_deck", default_deck_id)
	cfg.set_value("net", "name", player_name)
	cfg.set_value("net", "host", lobby_host)
	cfg.set_value("net", "port", lobby_port)
	cfg.set_value("net", "host_port", host_port)
	cfg.set_value("net", "auto_router", auto_router)
	cfg.set_value("net", "settings_version", 17)
	cfg.set_value("assets", "cards", card_art_override_dir)
	cfg.set_value("assets", "theme", theme_override_path)
	cfg.set_value("assets", "music", music_override_dir)
	cfg.save(SETTINGS_PATH)
	# Saving a setting no longer touches the window (0.17.2). Before, every
	# save re-applied the window mode, so with Fullscreen off a maximized
	# window fell back to its normal size whenever any button saved a
	# setting: Use on the Decks screen, picking a deck on the Battle screen,
	# renaming the profile, every Settings control (R-102).
	_apply_display()
	settings_changed.emit()


## The window mode before Fullscreen was switched on, to go back to.
var _windowed_mode := DisplayServer.WINDOW_MODE_WINDOWED


## Make the window match the Fullscreen setting -- and do nothing else. A
## window the player maximized, minimized or resized is left exactly as it
## is unless it has to enter or leave fullscreen; leaving fullscreen goes back
## to the state the window was in before (maximized, say).
func _apply_display() -> void:
	if DisplayServer.get_name() == "headless":
		return
	var mode := DisplayServer.window_get_mode()
	var is_full := mode == DisplayServer.WINDOW_MODE_FULLSCREEN or mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN
	if fullscreen and not is_full:
		_windowed_mode = mode if mode != DisplayServer.WINDOW_MODE_MINIMIZED else DisplayServer.WINDOW_MODE_WINDOWED
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	elif not fullscreen and is_full:
		DisplayServer.window_set_mode(_windowed_mode)
